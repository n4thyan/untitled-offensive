# ...but OUR OWN original scripts are project source and must be tracked. The
# blanket *.gsc rule above exists to keep retail scripts out of git; these are
# negations so the custom map's per-map script is versioned like any other
# source file.
!/assets/scripts/
!/assets/scripts/*.gsc
