# ---- PROPRIETARY GAME DATA: never commit ----
# Local development logs from a session against the retail install.
/dev-logs/
/logs/
# Generated custom-map output. mp_toccoa is built from source
# (tools/toccoa/layout.py -> out.bsp -> main-untitled/untitled.pk3), so the
# source of truth is the Python and no binary needs committing.
/main-untitled/
tools/toccoa/out.bsp
tools/toccoa/__pycache__/
# Local retail installs (Call of Duty 2003, Wolfenstein ET, United Offensive) are
# read-only references and MUST NOT enter git history.
/game-data/
/cod-install/
/et-install/
/uo-install/
/assets/proprietary/
/assets/extracted/
/compat/extracted/
/cache/
